/* Abstract 64x32 SRAM.
   Timing/power are ASSUMPTIONS for a 16A-class node, not PDK data. */
library(fakeram45_64x32) {
  technology (cmos) ;
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1mA" ;
  leakage_power_unit : "1pW" ;
  pulling_resistance_unit : "1kohm" ;
  capacitive_load_unit (1, ff) ;
  nom_process : 1 ;
  nom_voltage : 0.7 ;
  nom_temperature : 27 ;
  operating_conditions (TYPICAL) { process : 1 ; voltage : 0.7 ; temperature : 27 ; }
  default_operating_conditions : TYPICAL ;
  input_threshold_pct_rise : 50 ;
  input_threshold_pct_fall : 50 ;
  output_threshold_pct_rise : 50 ;
  output_threshold_pct_fall : 50 ;
  slew_lower_threshold_pct_rise : 20 ;
  slew_upper_threshold_pct_rise : 80 ;
  slew_lower_threshold_pct_fall : 20 ;
  slew_upper_threshold_pct_fall : 80 ;
  default_max_transition : 0.2 ;
  type (addr_t) { base_type : array ; data_type : bit ; bit_width : 6 ; bit_from : 5 ; bit_to : 0 ; downto : true ; }
  type (data_t) { base_type : array ; data_type : bit ; bit_width : 32 ; bit_from : 31 ; bit_to : 0 ; downto : true ; }
  cell (fakeram45_64x32) {
    area : 20.6388 ;
    interface_timing : true ;
    dont_use : true ;
    dont_touch : true ;
    is_macro_cell : true ;
    cell_leakage_power : 122880.0 ;
    pin (clk) {
      direction : input ;
      capacitance : 2.640 ;
      clock : true ;
      min_pulse_width_high : 0.05 ;
      min_pulse_width_low : 0.05 ;
      internal_power () {
        rise_power (scalar) { values ("144.0") ; }
        fall_power (scalar) { values ("0.0") ; }
      }
    }
    pin (ce_in) {
      direction : input ;
      capacitance : 0.600 ;
      timing () { related_pin : "clk" ; timing_type : setup_rising ;
        rise_constraint (scalar) { values ("0.03") ; }
        fall_constraint (scalar) { values ("0.03") ; } }
      timing () { related_pin : "clk" ; timing_type : hold_rising ;
        rise_constraint (scalar) { values ("0.01") ; }
        fall_constraint (scalar) { values ("0.01") ; } }
    }
    pin (we_in) {
      direction : input ;
      capacitance : 0.600 ;
      timing () { related_pin : "clk" ; timing_type : setup_rising ;
        rise_constraint (scalar) { values ("0.03") ; }
        fall_constraint (scalar) { values ("0.03") ; } }
      timing () { related_pin : "clk" ; timing_type : hold_rising ;
        rise_constraint (scalar) { values ("0.01") ; }
        fall_constraint (scalar) { values ("0.01") ; } }
    }
    bus (addr_in) { bus_type : addr_t ;
      direction : input ;
      capacitance : 0.600 ;
      timing () { related_pin : "clk" ; timing_type : setup_rising ;
        rise_constraint (scalar) { values ("0.03") ; }
        fall_constraint (scalar) { values ("0.03") ; } }
      timing () { related_pin : "clk" ; timing_type : hold_rising ;
        rise_constraint (scalar) { values ("0.01") ; }
        fall_constraint (scalar) { values ("0.01") ; } }
    }
    bus (wd_in) { bus_type : data_t ;
      direction : input ;
      capacitance : 0.600 ;
      timing () { related_pin : "clk" ; timing_type : setup_rising ;
        rise_constraint (scalar) { values ("0.03") ; }
        fall_constraint (scalar) { values ("0.03") ; } }
      timing () { related_pin : "clk" ; timing_type : hold_rising ;
        rise_constraint (scalar) { values ("0.01") ; }
        fall_constraint (scalar) { values ("0.01") ; } }
    }
    bus (w_mask_in) { bus_type : data_t ;
      direction : input ;
      capacitance : 0.600 ;
      timing () { related_pin : "clk" ; timing_type : setup_rising ;
        rise_constraint (scalar) { values ("0.03") ; }
        fall_constraint (scalar) { values ("0.03") ; } }
      timing () { related_pin : "clk" ; timing_type : hold_rising ;
        rise_constraint (scalar) { values ("0.01") ; }
        fall_constraint (scalar) { values ("0.01") ; } }
    }
    bus (rd_out) { bus_type : data_t ;
      direction : output ;
      max_capacitance : 20.0 ;
      timing () { related_pin : "clk" ; timing_type : rising_edge ; timing_sense : non_unate ;
        cell_rise (scalar) { values ("0.1456") ; }
        cell_fall (scalar) { values ("0.1456") ; }
        rise_transition (scalar) { values ("0.02") ; }
        fall_transition (scalar) { values ("0.02") ; } }
    }
  }
}
